#!/usr/bin/env bash
# aspen-users — admin CLI for Aspen's user registry.
#
# Thin wrapper: activates the venv and runs aspen.users_cli, so you don't have to
# remember to source anything first. Run it from anywhere.
#
#   ./aspen-users list
#   ./aspen-users add U01ABC2DEF --alias arun --name "Arun N."
#   ./aspen-users remove arun
#
# This is the only thing that changes who may talk to Aspen — the bot itself has
# no code path that writes the registry. Changes take effect on the affected
# user's next message; no restart.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

if [[ ! -f .env ]]; then
    echo "ERROR: .env not found (needed for SLACK_BOT_TOKEN and CALCULATIONS_ROOT)." >&2
    exit 1
fi

if [[ -f venv/bin/activate ]]; then
    # shellcheck disable=SC1091
    source venv/bin/activate
fi

exec python -m aspen.users_cli "$@"
