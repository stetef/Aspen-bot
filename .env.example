# Slack (from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# --- Users -------------------------------------------------------------------
# Who may talk to Aspen normally lives in the USER REGISTRY (users.json below),
# managed with `./aspen-users add|remove|list`. Changes there apply on the user's
# next message, with no restart.
#
# This variable is the BOOTSTRAP allowlist, used only until the registry file
# exists (fresh install) or if it can't be parsed and nothing was ever cached —
# so a typo in users.json can't lock the admin out. Comma-separated Slack user
# IDs. In dev mode this should be ONLY your own user ID.
# Find yours: Slack → click your name → View full profile → … → Copy member ID
ASPEN_ALLOWED_SLACK_USER_IDS=U0XXXXXXXXX
# Optional: Slack user ID of Aspen's admin — the one @-mentioned in "not
# authorized" and group-DM refusals, and the only user who may edit the shared
# _group workflow. Leave empty to use the registry's `role: admin` user, falling
# back to the first active user (or the first bootstrap ID).
ASPEN_ADMIN_SLACK_USER_ID=

# Directory for state that outlives a release: the user registry, per-user
# workflow files, and Aspen's project metadata. Default ~/.aspen (created 0700
# at startup).
#
# SECURITY: this must NOT sit inside WORKSPACE_ROOT or ASPEN_SANDBOX_WRITE_PATHS.
# Those are writable by sandboxed analysis code, which would let generated code
# edit the allowlist or another user's workflow directly, bypassing the ownership
# and admission checks. Aspen refuses to start if it detects this. Metadata is
# held to the same rule for a second reason: it is read back into the model's
# context on later turns, so a sandbox-writable copy is an injection path.
# The line to hold: WORKSPACE_ROOT is what the sandbox produces, STATE_DIR is
# what steers the agent.
ASPEN_STATE_DIR=
# Override the individual paths if you need them apart (default: under STATE_DIR).
ASPEN_USERS_FILE=
ASPEN_WORKFLOWS_ROOT=
# Aspen's per-project notes, mirroring each calculations root:
#   <root>/<alias>__<slack-id>/<project>/metadata.md
# These replace the old in-tree metadata.md — the agent writes nothing inside any
# calculations directory. In-tree files stay readable until you migrate them.
ASPEN_METADATA_ROOT=
ASPEN_METADATA_HISTORY_ROOT=
# Pending asks for the admin: who wants access, who wants a calculations root.
# Aspen grants neither — it records the ask and DMs the admin the command to run
# (`aspen-users requests` is the same queue). Needs the `im:write` Slack scope to
# open that DM; without it Aspen posts to the admin's user ID, which works once a
# DM with the app exists.
ASPEN_REQUESTS_FILE=
# Don't re-DM the admin about the same pending ask more often than this (hours).
# Default 12, so five messages from an impatient newcomer are one notification.
ASPEN_REQUEST_NOTIFY_COOLDOWN_HOURS=
# Cap on a single workflow file (they're prose, not data). Default 60000.
ASPEN_MAX_WORKFLOW_BYTES=

# Post the agent's own commentary as it works, rather than holding every word
# until the answer is ready. A turn is mostly tool time, so without this the user
# waits in silence behind the typing indicator and then gets the narration
# retroactively glued to the top of the answer. Default true; set false for a
# quieter room.
ASPEN_INTERIM_UPDATES=

# --- DEMO mode -------------------------------------------------------------
# `DEMO` in a DM runs a walkthrough for people who are not users yet. Safe to
# leave on for a whole workspace: a demo session can read ONLY the demo tree,
# writes nothing (not even a temporary registry entry), and renders the admin
# request into the thread instead of sending it. It does cost model time, hence
# the caps. See aspen/demo.py.
ASPEN_DEMO_ENABLED=
# The fabricated calculations it runs against. Defaults to examples/demo-calculations
# in the repo; regenerate with `python examples/build_demo_tree.py`.
ASPEN_DEMO_ROOT=
ASPEN_DEMO_MAX_TURNS=
ASPEN_DEMO_MAX_SESSIONS=
ASPEN_DEMO_MAX_STARTS_PER_DAY=
ASPEN_DEMO_SESSION_TTL_SECONDS=
# Actually DM the admin during a demo. Off by default — a demo anyone can trigger
# must not be able to page a human.
ASPEN_DEMO_REAL_ADMIN_DM=

# --- Turn telemetry --------------------------------------------------------
# One JSON line per turn (who, when, which tools, latency, outcome, cost, and
# optionally the question text), so the tool surface and prompt can be tuned for
# the tasks people actually bring. Default on.
#
# This is the operator floor — an off here overrides everything, and needs a
# restart. Day-to-day switching is `./aspen-users telemetry`, which hot-reloads:
#
#   ./aspen-users telemetry status                    # what's recorded, and why
#   ./aspen-users telemetry content on --days 30      # collect question text,
#                                                     # window closes by itself
#   ./aspen-users telemetry content off               # metrics only
#   ./aspen-users telemetry exclude arun              # one person, metrics only
#   ./aspen-users telemetry prune --older-than 90
#
# Same SECURITY rule as the registry above: these paths must sit outside
# WORKSPACE_ROOT and ASPEN_SANDBOX_WRITE_PATHS, or generated analysis code could
# read the log or switch off its own recording. Aspen refuses to start otherwise.
ASPEN_TELEMETRY=
# Override the individual paths if you need them apart (default: under STATE_DIR).
ASPEN_TELEMETRY_DIR=
ASPEN_TELEMETRY_STATE_FILE=
# Cap on the recorded question text. Default 4000 (the true length is kept anyway).
ASPEN_TELEMETRY_MAX_TEXT=

# Slack scopes (set at api.slack.com → OAuth & Permissions; reinstall after changes):
#   app_mentions:read, chat:write, files:write, im:history, channels:history
#   mpim:history, mpim:read  → let Aspen work in group DMs (multi-person DMs)
#   users:read               → resolve member names for the group-DM participant gate
#   im:write                 → DM the admin about access / calculations-root requests.
#                              Optional: without it Aspen posts to the admin's user ID,
#                              which Slack delivers once a DM with the app exists.
# NOTE: Slack can't add a bot to an existing 1:1 human DM. To chat with Aspen
# alongside another person, create a GROUP DM that includes Aspen and @-mention it.
# Group DMs are gated: every human member must be on the allowlist above, or Aspen
# declines (fail-closed).

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Internal secret shared between aspen-bot.py and tool_server.py
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_INTERNAL_SECRET=<32-byte hex string>

# Paths
# CALCULATIONS_ROOT: used by aspen-bot.py for file browsing tools
CALCULATIONS_ROOT=/home/<user>/calculations
# PROJECTS_ROOT: mounted read-only into the bwrap sandbox for analysis
PROJECTS_ROOT=/home/<user>/calculations

# Both of the above are now the DEFAULT root — the one used for anyone who has no
# root of their own. Per-user roots live in the registry (`aspen-users set-root
# <who> <path>`); leaving everyone without one keeps the old single-root behavior
# exactly. Everyone may READ every root, as on the shared filesystem — see
# aspen/roots.py.
#
# Shared roots hold group project data that belongs to nobody in particular.
# Comma-separated name=/absolute/path; the name is how the agent addresses it
# ('@smb/csd/...'). Roots must never contain one another — Aspen refuses to start.
# ASPEN_SHARED_CALC_ROOTS=smb=/data/smb-shared,legacy=/data/old-calcs
#
# Budget for a cross-root search (search_files everyone=true). Shared across
# roots; the tool reports which roots it could not reach. Default 4x
# ASPEN_SEARCH_MAX_FILES.
# ASPEN_SEARCH_MAX_FILES_ALL=12000
# WORKSPACE_ROOT: writable workspace for figures, logs, cache, db
WORKSPACE_ROOT=/home/<user>/aspen_workspace
# SQLITE_DB_ROOT: prefer node-local disk; fall back to WORKSPACE_ROOT/db on Lustre
SQLITE_DB_ROOT=/tmp/aspen_db
# Set to "true" only if SQLITE_DB_ROOT is on local disk (not Lustre/NFS)
SQLITE_USE_WAL=false

# Bot <-> tool server link: a Unix-domain socket (a file), NOT a TCP port — so
# other users on a shared node can't reach it. Leave unset to use the default
# <WORKSPACE_ROOT>/run/tool.sock. Keep the path short (Linux caps socket paths at
# ~108 chars). The tool server places it in a 0700 directory, which is what keeps
# other local users out (they can't enter the dir to reach the socket).
ASPEN_TOOL_SERVER_SOCKET=

# ---- Claude Agent SDK backend (these are the defaults) ----
# Requires the claude-agent-sdk package + the Claude Code CLI binary.
# Path to the Claude Code CLI binary. Leave empty to auto-discover `claude` on
# PATH; set it when PATH is minimal (e.g. under systemd). Use the
# version-independent symlink (~/.local/bin/claude), NOT a versioned file.
# Find yours with: which claude
# Example: CLAUDE_CLI_PATH=/home/<user>/.local/bin/claude
CLAUDE_CLI_PATH=
# Auth. true (default) = use the Claude Code login / subscription (you must have
# run `claude` and logged in). false = use ANTHROPIC_API_KEY (API billing).
ASPEN_SDK_USE_SUBSCRIPTION=true
# Per-turn tool-call (agentic round) cap, passed to the SDK as max_turns. Multi-step
# requests (e.g. update metadata + attach a figure + regenerate a plot) need plenty
# of rounds; if this is too low the turn ends early with error_max_turns and the bot
# asks you to say "continue". Raise it for fewer interruptions (costs more per turn).
AGENT_MAX_ROUNDS=25
# Upper bound on concurrently parked conversation sessions.
MAX_OPEN_SESSIONS=20
# Pre-connected spare sessions kept on standby. Connecting a session spawns the
# Claude Code CLI and waits on its init handshake (~1.7 s), which otherwise lands
# inside the first message of every new Slack thread; warming spares in the
# background moves that off the user's critical path. Each spare is a live CLI
# subprocess (memory for latency) and counts against MAX_OPEN_SESSIONS. 0 disables.
ASPEN_PREWARM_SESSIONS=1
# Built-in Bash tool allowlist for HPC job investigation. Comma-separated Claude
# Code permission rules; "Bash(cmd:*)" is a prefix match. Matching commands run
# without prompting; everything else is denied. Leave unset for the read-only
# default: Slurm ONLY (squeue/sacct/sinfo/sstat/sprio/'scontrol show').
# SECURITY: general file-readers (cat/head/tail/ls/grep/wc/sort/uniq) are NOT in
# the default. With the OS sandbox off, Bash runs as the bot's Unix user, so those
# would let an allowlisted user read any file it can (SSH keys, this .env, your
# ~/.claude credentials). Use the path-scoped read_file tool for calculations
# files instead. find/awk/sed are likewise excluded (their flags can write/exec).
# Only add such commands behind the OS sandbox with ASPEN_SANDBOX_DENY_READ_PATHS.
# Example (explicit Slurm-only):
# ASPEN_BASH_ALLOWLIST=Bash(squeue:*),Bash(sacct:*),Bash(sinfo:*),Bash(sstat:*),Bash(sprio:*),Bash(scontrol show:*)
ASPEN_BASH_ALLOWLIST=

# ---- Bash OS sandbox (give the agent a WRITE surface you control) ----
# Off by default. When true, the agent's Bash commands run inside Claude Code's
# OS sandbox (Linux: bubblewrap + socat — `apt-get install bubblewrap socat`;
# macOS: built-in Seatbelt). The agent can then read broadly and WRITE only
# within the paths you grant below — a boundary enforced by the OS, separate
# from what the bot's Unix user can touch. See https://code.claude.com/docs/en/sandboxing
# The read-only Slurm commands below run OUTSIDE the jail (they need cluster
# network/munge) but stay gated by ASPEN_BASH_ALLOWLIST.
#
# Verified enforcing 2026-06-24 (CLI 2.1.190 + bubblewrap 0.4.0): writes outside
# the allow-list are blocked. Two requirements: (1) `socat` + `bubblewrap` must be
# installed (start.sh bootstraps socat without sudo); (2) the bot must run as a
# normal top-level process — Claude Code disables the sandbox if it's launched
# nested inside another Claude Code session. Verify anytime: ./verify_sandbox.sh
# from a plain shell. Default off; flip to true after setting the write paths below.
ASPEN_SANDBOX_ENABLED=false
# Fail closed: refuse to start if the sandbox can't initialize (missing bwrap,
# unsupported platform) instead of silently running unsandboxed. Keep true.
ASPEN_SANDBOX_FAIL_IF_UNAVAILABLE=true
# Auto-approve commands that run inside the jail (no per-command prompt).
ASPEN_SANDBOX_AUTO_ALLOW=true
# Allow escaping the jail via dangerouslyDisableSandbox. Keep false (strict).
ASPEN_SANDBOX_ALLOW_UNSANDBOXED=false
# Session working dir when sandboxed (writable by default). Defaults to
# WORKSPACE_ROOT. Point it at a scratch dir so the agent stays out of repo/home.
ASPEN_SANDBOX_WORKDIR=
# Comma-separated paths the agent may WRITE to (the surface you grant). Prefixes:
# "/abs" absolute, "~/x" home-relative, "x" relative to the workdir.
# Example: ASPEN_SANDBOX_WRITE_PATHS=/scratch/aspen,~/aspen_out
ASPEN_SANDBOX_WRITE_PATHS=
# Optional read controls inside the jail (e.g. hide credentials).
# Example: ASPEN_SANDBOX_DENY_READ_PATHS=~/.ssh,~/.aws
ASPEN_SANDBOX_DENY_READ_PATHS=
ASPEN_SANDBOX_ALLOW_READ_PATHS=
# Network domains reachable from the jail. Empty = no network (safest).
# Example: ASPEN_SANDBOX_ALLOWED_DOMAINS=pypi.org,files.pythonhosted.org
ASPEN_SANDBOX_ALLOWED_DOMAINS=
# Unix sockets reachable from the jail. Careful — docker.sock is an escape.
ASPEN_SANDBOX_UNIX_SOCKETS=
# Commands that run OUTSIDE the jail (need host network/munge). Default = the
# read-only Slurm clients. They remain gated by ASPEN_BASH_ALLOWLIST.
ASPEN_SANDBOX_EXCLUDED_COMMANDS=squeue,sacct,sinfo,sstat,sprio,scontrol

# ---- optional tuning (these are the defaults) ----
ANTHROPIC_MODEL=claude-opus-4-8
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=300
CONTEXT_EXPIRY_SECONDS=14400
MAX_CONCURRENT_EXECUTIONS=5
MAX_FILE_READ_BYTES=50000
MAX_STDOUT_CHARS=10000
MAX_STDERR_CHARS=2000
MAX_FIGURE_BYTES=5242880
FIGURE_ARCHIVE_MAX_BYTES=2147483648
FIGURE_ARCHIVE_TRIM_BYTES=1610612736
EXECUTION_TIMEOUT_SECONDS=120

# ---- Analysis sandbox (bwrap) ----
# run_python_analysis runs LLM-generated code under bubblewrap (no network,
# read-only project mount, only figures/cache writable). Requires `bubblewrap`.
# ANALYSIS_PYTHON: interpreter (a venv) with the analysis libraries. start.sh
# builds this venv from analysis-requirements.txt and exports this var; set it
# only to point at an interpreter you manage yourself.
# Default: $WORKSPACE_ROOT/analysis-venv/bin/python
ANALYSIS_PYTHON=
# ANALYSIS_VENV: where start.sh builds the analysis venv (default below).
# ANALYSIS_VENV=/home/<user>/aspen_workspace/analysis-venv
# BWRAP_BIN: bubblewrap binary (default: bwrap on PATH).
# BWRAP_BIN=bwrap
# Extra host paths bind-mounted read-only so the interpreter's shared libs resolve.
# ANALYSIS_RO_PATHS=/usr,/lib,/lib64,/bin,/sbin
# Per-task resource caps (bwrap has no cgroup limits; enforced via prlimit). 0 = off.
# RLIMIT_AS caps virtual address space; set generously (BLAS reserves large arenas) —
# the wall-clock timeout above is the primary backstop.
ANALYSIS_AS_LIMIT_BYTES=2147483648
ANALYSIS_FSIZE_LIMIT_BYTES=536870912
# CPU-seconds cap (SIGXCPU). Empty/unset defaults to EXECUTION_TIMEOUT_SECONDS.
# ANALYSIS_CPU_LIMIT_SECONDS=120
